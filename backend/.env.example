# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Configuration (PostgreSQL) - Required in Stage 6+
DB_HOST=localhost
DB_PORT=5432
DB_NAME=student_election_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/student_election_db

# Authentication Secrets (JWT & Sessions) - Required in Stage 8+
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_long
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=your_super_secret_refresh_key_min_32_chars
REFRESH_TOKEN_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=10

# Email/SMTP Configuration (Nodemailer) - Required in Stage 8+
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Student Election Portal" <noreply@student-election.local>

# File Upload / Storage Configuration
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=./uploads
